SERVICE_URL=todo.${DOMAIN}

DT_NAME=selfhosted
DT_IS_DONE_TICK_DOT_COM=false
DT_IS_USER_CREATION_DISABLED=true
DT_DATABASE_TYPE=sqlite
DT_SQLITE_PATH=/donetick-data/donetick.db
DT_DATABASE_MIGRATION=true
DT_JWT_SESSION_TIME=168h
DT_JWT_MAX_REFRESH=1440h
DT_SERVER_PORT=2021
DT_SERVER_READ_TIMEOUT=2s
DT_SERVER_WRITE_TIMEOUT=1s
DT_SERVER_RATE_PERIOD=60s
DT_SERVER_RATE_LIMIT=300
DT_SERVER_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:7926,https://localhost,capacitor://localhost,https://todo.${DOMAIN}
DT_SERVER_SERVE_FRONTEND=true
DT_SCHEDULER_JOBS_DUE_JOB=30m
DT_SCHEDULER_JOBS_OVERDUE_JOB=3h
DT_SCHEDULER_JOBS_PRE_DUE_JOB=3h
DT_OAUTH2_CLIENT_ID=Donetick
DT_OAUTH2_NAME=Donetick
DT_OAUTH2_SCOPES=openid,profile,email
DT_OAUTH2_AUTH_URL=https://id.${DOMAIN}/authorize
DT_OAUTH2_TOKEN_URL=https://id.${DOMAIN}/api/oidc/token
DT_OAUTH2_USER_INFO_URL=https://id.${DOMAIN}/api/oidc/userinfo
DT_OAUTH2_REDIRECT_URL=https://todo.${DOMAIN}/auth/oauth2
DT_SINGLE_CIRCLE_INSTANCE=true
DT_OAUTH2_ADMIN_GROUPS=admin
DT_DISABLE_PASSWORD_AUTH=true
DT_STORAGE_STORAGE_TYPE=local
